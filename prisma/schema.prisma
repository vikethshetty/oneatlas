generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Provider {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  models    Model[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Model {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  context     String
  pricing     String
  badge       String?
  mark        String
  tone        String
  rankingScore Int     @default(0)
  modelType    String  @default("Language model")
  modalities   String[] @default([])
  capabilities String[] @default([])
  contextTokens Int?
  inputPrice   Float?
  outputPrice  Float?
  releasedAt   DateTime?
  openWeights  Boolean @default(false)
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  benchmarks  BenchmarkScore[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([providerId])
  @@index([rankingScore])
  @@index([modelType])
  @@index([releasedAt])
}

model BenchmarkScore {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  score     Float
  source    String?
  updatedAt DateTime @updatedAt
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, name])
  @@index([name, score])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
